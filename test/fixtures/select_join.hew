actor FastWorker {
    receive fn compute(x: i64) -> i64 {
        x * 2
    }
}

actor SlowWorker {
    receive fn compute(x: i64) -> i64 {
        x * 3
    }
}

fn main() {
    let fast = spawn FastWorker;
    let slow = spawn SlowWorker;
    // Test select - fast should win
    let result = select {
        r from fast.compute(5) => match r {
            .Ok(value) => value,
            .Err(_) => -1,
        },
        r from slow.compute(5) => match r {
            .Ok(value) => value,
            .Err(_) => -1,
        },
        after 2s => -1,
    };
    println("select result:");
    println(result);

    // Test fork/await - both results
    let (fast_result, slow_result) = await fork (fast.compute(10), slow.compute(10));
    let a = match fast_result {
        .Ok(value) => value,
        .Err(_) => -1,
    };
    let b = match slow_result {
        .Ok(value) => value,
        .Err(_) => -1,
    };
    println("fork results:");
    println(a);
    println(b);
}
