// Machine declarations and duration literals

machine TrafficLight {
    // Input-event vocabulary
    events {
        Timer;
        Emergency { reason: string; }
    }

    state Red;
    state Green;
    state Yellow;

    // State routing uses =>.
    on Timer: Red => Green {
        .Green
    }

    on Timer: Green => Yellow {
        .Yellow
    }

    on Timer: Yellow => Red {
        .Red
    }

    on Emergency: Red => Red reenter {
        .Red
    }

    default { state }
}

// Duration literals in various forms
fn duration_demo() {
    let ns_val = 100ns;
    let us_val = 50us;
    let ms_val = 200ms;
    let s_val = 5s;
    let m_val = 2m;
    let h_val = 1h;
}

// Supervisor with child specs
actor Counter {
    let value: i64;
}

actor Logger {
    let level: i64;
}

supervisor ServiceTree {
    strategy: one_for_one;
    intensity: 5 within 60s;

    child counter: Counter(value: 100);
    child debug_log: Logger(level: 1);
    child error_log: Logger(level: 3);
}
