//! Tests for generic Option methods and a std.testing import.

import std.option;

import std.testing;

#[test]
fn test_is_some_with_value() {
    let _seed = testing.seed();
    let x = Option.Some(42);
    assert(x.is_some());
}

#[test]
fn test_is_some_with_none() {
    let x: Option<i64> = Option.None;
    assert(x.is_none());
}

#[test]
fn test_unwrap_some() {
    let x = Option.Some(42);
    assert(x.expect("present") == 42);
}

#[test]
fn test_unwrap_or_some() {
    let x = Option.Some(42);
    assert((x ?? 0) == 42);
}

#[test]
fn test_unwrap_or_none() {
    let x: Option<i64> = Option.None;
    assert((x ?? -1) == -1);
}
