// Advanced features: while-let, structured scopes, lambda actors, type aliases,
// indirect enums, trait bounds, and where clauses

// Type alias
type IntPair = (i32, i32);

// Indirect enum (recursive)
indirect enum Expr {
    Lit(i32);
    Add(Expr, Expr);
    Neg(Expr);
}

// Trait with bounds and associated type
trait Serializable {
    fn serialize(self) -> bytes;
    type Output;
}

// Actor with init block and mailbox
actor BufferedWorker {
    let id: i32;
    var buffer: i32;

    mailbox 16;

    init(id: i32) {
        println(f"Worker {id} started");
    }

    receive fn process(value: i32) -> i32 {
        buffer = buffer + value;
        buffer
    }
}

fn scoped_sum() -> i64 {
    30
}

// Structured scope with a named child task in an actor handler
actor ScopedWorker {
    receive fn run() {
        scope {
            fork result = scoped_sum();
            await result;
        }
    }
}

// Lambda actors
fn test_lambda_actors() {
    let doubler = actor |x: i64| {
        println(x * 2);
    };
    doubler.send(21);
}

// For loop with range
fn test_for_range() {
    for i in 0..10 {
        println(i);
    }
}

// While-let
fn test_while_let() {
    let value: Option<i64> = Option.Some(42);
    while let .Some(x) = value {
        println(x);
        break;
    }
}

// Unsafe block
fn test_unsafe() {
    unsafe {
        let _ptr = malloc(64);
    }
}

// Wire enum
#[wire]
enum Command {
    Start;
    Stop;
    Pause;
}

// Wire type with all features
#[wire]
type Packet {
    header: u32 @1,
    payload: Option<bytes> @2 optional,
    version: u16 @3 deprecated,
}

// Extern block
extern "C" {
    fn malloc(size: usize) -> *mut u8;
    fn free(ptr: *mut u8);
}

// Const declarations
pub const MAX_BUFFER: u32 = 1024;
const PI: f64 = 3.14159;

// String interpolation with complex expressions
fn test_interpolation() {
    let name = "world";
    let x = 42;
    println(f"Hello {name}, the answer is {x + 1}");
}

// Regex and raw strings
fn test_string_types() {
    let raw = r"no \escapes here";
    let regex = re"[a-z]+";
    let byte_str = b"binary data";
}

// Cast and try expressions
fn test_cast_try() -> Option<i64> {
    let _x = 42 as u64;
    let result = Option.Some(42)?;
    Option.Some(result)
}

// Array and tuple expressions
fn test_collections() {
    let arr = [1, 2, 3, 4, 5];
    let repeated = [0; 100];
    let tuple = (1, "hello", true);
    let map = {"key": "value", "name": "hew"};
}

// Labeled loops with break/continue
fn test_labeled_loops() {
    @outer: for i in 0..10 {
        @inner: while true {
            if i > 5 {
                break @outer;
            }
            continue @inner;
        }
    }
}

// Compound assignment operators
fn test_compound_assign() {
    var x = 10;
    x += 5;
    x -= 3;
    x *= 2;
    x /= 4;
    x %= 3;
    x &= 0xFF;
    x |= 0x01;
    x ^= 0x10;
    x <<= 2;
    x >>= 1;
}

// Visibility modifiers
pub fn public_fn() {}

fn add(a: i32, b: i32) -> i32 {
    a + b
}

fn main() {
    test_lambda_actors();
    test_for_range();
    test_interpolation();
    test_string_types();
    test_collections();
    test_labeled_loops();
    test_compound_assign();
}
