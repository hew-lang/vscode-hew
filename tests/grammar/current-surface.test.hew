// SYNTAX TEST "source.hew"

fn close(consume self) {}
//       ^^^^^^^ storage.modifier.receiver.hew
//               ^^^^ variable.language.self.hew

fn consume(value: i64) -> i64 { value }
// ^^^^^^^ entity.name.function.hew

let async = 1;
//  ^^^^^ - invalid.removed.hew

async gen fn values() -> i64 { yield 1; }
// <- invalid.removed.hew

for item in stream { println(item); }
// <- keyword.control.hew

for await item in stream { println(item); }
// <- invalid.removed.hew

let expired = work() | after 1s;
//                   ^^^^^^^ invalid.removed.hew

// -- A block-like statement ends at its `}`; the dotted tail is a variant --

fn ok_after_unsafe() -> Result<i64, string> {
    unsafe { work(); }
    .Ok(2)
//   ^^ entity.name.variant.hew
}

fn ok_after_scope() -> Result<i64, string> {
    scope { work(); }
    .Ok(3)
//   ^^ entity.name.variant.hew
}
